# ----------------------------------------------------------------------
# AcheIAki - O Marketplace Inteligente da sua Região (multi-tenant)
# ----------------------------------------------------------------------

# 1. Definir prioridade de carregamento de arquivos na raiz (entra direto no Marketplace AcheIAki)
DirectoryIndex marketplace.html index.php index.html

# 2. Desabilitar listagem de diretório e bloquear arquivos sensíveis por segurança
Options -Indexes

<FilesMatch "^(router\.php|auth_config\.php|verificar_sistema\.php|go_live_smoke\.php|worker\.php|db_pdo\.php|Database\.php|store_schema\.php|tenant_init\.php|pedido_acesso\.php|.*_lib\.php|configurar-producao\.html|openapi-pdv\.json|Dockerfile|Procfile|railway\.json|\.env.*|.*\.(md|log|sql|bak|map|sh|ps1|yml|yaml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# 2.1 Proteção Anti-WebCopy/HTTrack + SEO Dinâmico (Google Search Console) + Multi-tenant
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (CyotekWebCopy|WebCopy|HTTrack|SiteSucker|Teleport|WebZIP|WebCopier|WebReaper|WebStripper|Offline\ Explorer|Scrapy|Wget|AhrefsBot|SemrushBot|MJ12bot|DotBot|Bytespider) [NC]
    RewriteRule ^ - [F,L]
    RewriteRule ^(scripts|mobile-capacitor)(/|$) - [F,L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]
    RewriteRule ^robots\.txt$ robots.php [L,NC]
    RewriteRule ^loja/([a-zA-Z0-9_-]+)/(css|js|assets)/(.*)$ $2/$3 [L,NC]
    RewriteRule ^loja/([a-zA-Z0-9_-]+)/([A-Za-z0-9_-]+\.php)$ $2?tenant=$1 [L,QSA,NC]
    RewriteRule ^loja/([a-zA-Z0-9_-]+)/?$ index.html?tenant=$1 [L,QSA,NC]
    RewriteRule ^loja/([a-zA-Z0-9_-]+)/([A-Za-z0-9_-]+\.html)$ $2?tenant=$1 [L,QSA,NC]
</IfModule>

# 3. Segurança HTTP e controle de cache
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(css|js|html|php)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>
</IfModule>
