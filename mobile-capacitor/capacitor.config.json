{
  "appId": "app.acheiaki.delivery",
  "appName": "AcheIAki",
  "webDir": "www",
  "server": {
    "url": "https://acheiaki-production.up.railway.app/marketplace.html",
    "cleartext": false,
    "allowNavigation": [
      "*.railway.app",
      "*.acheiaki.com.br",
      "accounts.google.com",
      "www.mercadopago.com.br"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0b192c",
      "androidScaleType": "CENTER_CROP"
    }
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic"
  }
}
