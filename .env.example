# =============================================================================
# AcheIAki — variáveis de produção (copie para .env no host; nunca commite .env)
# =============================================================================
#
# CHECKLIST RÁPIDO (painel Railway → serviço → Variables):
# [ ] MASTER_USER + MASTER_PASS fortes
# [ ] ACHEIAKI_APP_SECRET com 32+ caracteres aleatórios
# [ ] MySQL ou PostgreSQL ligado (MYSQL_URL ou painel SuperAdmin → Banco)
# [ ] ACHEIAKI_MP_ACCESS_TOKEN + webhook MP → https://SEU_DOMINIO/mp_webhook.php
# [ ] Enviar assets/images/acheiaki-icon.jpg (512px) ao repositório ou volume
# [ ] php go_live_smoke.php https://SEU_DOMINIO
#
# =============================================================================

# Banco (Railway injeta ao adicionar MySQL/PostgreSQL)
# MYSQL_URL=mysql://usuario:senha@host:3306/railway
# DATABASE_URL=postgres://usuario:senha@host:5432/railway

# Obrigatório em produção
ACHEIAKI_MASTER_USER=admin_acheiaki
ACHEIAKI_MASTER_PASS=TroqueEstaSenhaForte!2026
ACHEIAKI_APP_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# LGPD
ACHEIAKI_DPO_EMAIL=privacidade@acheiaki.com.br

# Railway: não espelhar JSON em disco (recomendado; padrão automático no Railway)
# ACHEIAKI_SQL_MIRROR_JSON=0

# Opcionais
# ACHEIAKI_GOOGLE_CLIENT_ID=
# ACHEIAKI_GOOGLE_MAPS_KEY=
# ACHEIAKI_MP_ACCESS_TOKEN=
# ACHEIAKI_IA_API_KEY=
# ACHEIAKI_GSC_TOKEN=