# Variáveis de ambiente recomendadas para deploy do AcheIAki no Railway

# Banco de Dados (Railway injeta automaticamente ao adicionar MySQL ou PostgreSQL)
# MYSQL_URL=mysql://usuario:senha@host:3306/railway
# DATABASE_URL=postgres://usuario:senha@host:5432/railway

# Segurança e Acesso Master (obrigatório definir senha forte em produção)
ACHEIAKI_MASTER_USER=admin_acheiaki
ACHEIAKI_MASTER_PASS=TroqueEstaSenhaForte!2026
ACHEIAKI_APP_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# LGPD e Contato Institucional
ACHEIAKI_DPO_EMAIL=privacidade@acheiaki.com.br

# Opcionais (somente se utilizar Google Sign-In, Mercado Pago ou Gemini híbrido)
# ACHEIAKI_GOOGLE_CLIENT_ID=
# ACHEIAKI_MP_ACCESS_TOKEN=
# ACHEIAKI_IA_API_KEY=
